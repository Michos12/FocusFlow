# Copy this file to .env and fill in the values.
# .env is gitignored - never commit real credentials.

# Database. The port must match the host port published in docker-compose.yml.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root123
DB_PORT=3307
DB_NAME=todo_app

# Auth. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
